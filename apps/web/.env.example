# apps/web — Vite. Copy to .env (git-ignored). Only VITE_* vars reach the browser.
# The front talks ONLY to the API — no Supabase/OpenAI secrets here.
VITE_API_URL=http://localhost:8000

# VAPI phone number (E.164) — safe to expose in the front
VITE_VAPI_PHONE_NUMBER=+10000000000
# VAPI public key — safe to expose, for in-browser voice calls
VITE_VAPI_PUBLIC_KEY=
