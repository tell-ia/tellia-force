{
  "unstable": [
    "sloppy-imports"
  ],
  "tasks": {
    "dev": "deno run --watch --sloppy-imports --allow-net --allow-read --allow-env --allow-ffi --allow-write --allow-sys --env-file src/main.ts",
    "start": "deno run --sloppy-imports --allow-net --allow-read --allow-env --allow-ffi --allow-write --allow-sys --env-file src/main.ts",
    "check": "deno check --sloppy-imports src/main.ts tests/",
    "test": "deno test --sloppy-imports --allow-net --allow-read --allow-env --allow-ffi --allow-write --allow-sys",
    "test:live": "RUN_LIVE_TESTS=1 deno test --sloppy-imports --allow-net --allow-read --allow-env --allow-ffi --allow-write --allow-sys --env-file tests/live/",
    "smoke": "deno run --sloppy-imports --allow-net --allow-env --env-file scripts/smoke.ts",
    "vapi:setup": "deno run --sloppy-imports --allow-net --allow-env --allow-read --env-file scripts/vapiSetup.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.6.0",
    "hono/": "npm:/hono@^4.6.0/",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.45.0",
    "zod": "npm:zod@^4.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@mastra/core": "npm:@mastra/core@1.78.0",
    "@mastra/core/": "npm:/@mastra/core@1.78.0/",
    "@mastra/memory": "npm:@mastra/memory@1.38.0",
    "@mastra/libsql": "npm:@mastra/libsql@1.26.2",
    "@mastra/hono": "npm:@mastra/hono@1.7.20",
    "@mastra/ai-sdk": "npm:@mastra/ai-sdk@1.11.1",
    "@mastra/ai-sdk/": "npm:/@mastra/ai-sdk@1.11.1/",
    "ai": "npm:ai@7.0.142",
    "ai/test": "npm:ai@7.0.142/test",
    "@libsql/client": "npm:@libsql/client@0.18.0",
    "@tellia/shared": "../../packages/shared/src/index.ts",
    "@tellia/shared/env": "../../packages/shared/src/env.ts",
    "@tellia/shared/api": "../../packages/shared/src/api.ts",
    "@tellia/shared/db": "../../packages/shared/src/db.ts",
    "@tellia/shared/irrigation": "../../packages/shared/src/irrigation.ts",
    "@tellia/shared/app": "../../packages/shared/src/app.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lock": true,
  "nodeModulesDir": "auto"
}
