# apps/api — Deno backend. Copy to .env (git-ignored). Loaded via `deno task dev`.
PORT=8000

# Supabase (new API keys: secret = server-only, bypasses RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# OpenAI — server-only
OPENAI_API_KEY=sk-proj-xxx

# VAPI phone number (E.164)
VAPI_PHONE_NUMBER=+10000000000

# CORS: comma-separated origins, or * in dev
CORS_ORIGINS=*
