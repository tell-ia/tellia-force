# apps/api — Deno backend. Copy to .env (git-ignored). Loaded via `deno task dev`.
PORT=8000

# Supabase (new API keys: secret = server-only, bypasses RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# OpenAI — server-only
OPENAI_API_KEY=sk-proj-xxx

# VAPI phone number (E.164)
VAPI_PHONE_NUMBER=+10000000000
# VAPI private key (dashboard > API Keys) — server-only, for `deno task vapi:setup`
VAPI_PRIVATE_KEY=
# Secret VAPI sends as x-vapi-secret on tool calls (openssl rand -hex 24). Unset = /vapi/tools off
VAPI_WEBHOOK_SECRET=
# Public URL of this API (your frp tunnel), where VAPI sends tool calls
VAPI_SERVER_URL=https://yourname-tellia-api.dev.review-time.info

# CORS: comma-separated origins, or * in dev
CORS_ORIGINS=*

# Chat / irrigation advisor (Mastra)
# Model router id; uses OPENAI_API_KEY for openai/*
MODEL=openai/gpt-6.1-sol
# Cheaper model for light helper work (thread titles, etc.)
MODEL_MINI=openai/gpt-6-luna
# Mastra memory + workflow storage (LibSQL file, git-ignored under apps/api/data/)
MASTRA_DB_URL=file:./data/mastra.db
# Default "today" (YYYY-MM-DD); empty/unset = the real date. The app's date chip overrides it at
# runtime (PUT /settings/date, kept in data/demo-date.json).
# DEMO_DATE=2026-07-05
# Expose Mastra built-in /api/* routes (unauthenticated: dev only). Default false = 404.
# OPEN_MASTRA_API=false
TIMEZONE=Europe/Paris
