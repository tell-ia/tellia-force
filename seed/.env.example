# Copy to seed/.env and fill in. Never commit .env.

# Supabase > Connect > Session pooler (port 5432). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Folder with the hackathon CSV files (the 12 GB dataset, not in git).
DATASETS_DIR=/path/to/dg-agri-hackathon-datasets

# Optional
# Marceau's FAO-56 CSV files. Empty = seed/fao56 (in git).
FAO_DIR=
# Demo farm in the dataset.
FARM_ID=FARM-02580
# Work after this date is stored as "planned" or left out. Empty = today. The API can still show any earlier date.
DEMO_TODAY=
# Phone numbers (E.164) of the farm members, in this order: Claire (main contact), Sophie, Monique, Camille.
MEMBER_PHONES=
