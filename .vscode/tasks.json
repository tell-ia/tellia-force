{
  "version": "2.0.0",
  "tasks": [
    {
      // Background Vite dev server, used as preLaunchTask by the Chrome config.
      // The problemMatcher tells VS Code the server is "ready" when Vite prints
      // its local URL, so the debugger launches at the right moment.
      "label": "web: vite dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in)"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "api: deno dev",
      "type": "shell",
      "command": "deno task dev",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
